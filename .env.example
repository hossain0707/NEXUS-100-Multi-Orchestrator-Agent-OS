NEXUS_ENVIRONMENT=development
NEXUS_API_TOKEN=
NEXUS_DATABASE_URL=sqlite+aiosqlite:////tmp/nexus.db
NEXUS_REDIS_URL=
NEXUS_GITHUB_TOKEN=
NEXUS_MAX_ORCHESTRATOR_HOPS=10
NEXUS_MAX_AGENT_DEPTH=6
NEXUS_MAX_RETRIES=3
NEXUS_TASK_TIMEOUT_SECONDS=900

# Adaptive model routing. Map these aliases to real provider model IDs when
# backend execution is enabled. ChatGPT MCP-only usage can leave them as-is.
NEXUS_MODEL_ROUTING_ENABLED=true
NEXUS_BACKEND_MODEL_EXECUTION_ENABLED=false
NEXUS_MODEL_FAST=fast
NEXUS_MODEL_BALANCED=balanced
NEXUS_MODEL_STRONG=strong
NEXUS_MODEL_PREMIUM=premium
NEXUS_MAX_MODEL_ESCALATIONS=2

NEXUS_MAX_OUTPUT_TOKENS_LOW=800
NEXUS_MAX_OUTPUT_TOKENS_MEDIUM=1600
NEXUS_MAX_OUTPUT_TOKENS_HIGH=3200
NEXUS_MAX_OUTPUT_TOKENS_EXTRA_HIGH=6000

# Optional OpenAI-compatible backend for NEXUS-managed model execution.
NEXUS_LLM_BASE_URL=https://api.openai.com/v1
NEXUS_LLM_API_KEY=
# Provider-specific field name, for example a reasoning-effort parameter.
# Leave blank if the provider/model does not expose one.
NEXUS_LLM_REASONING_PARAMETER=
