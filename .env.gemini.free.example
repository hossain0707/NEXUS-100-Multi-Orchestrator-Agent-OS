# OPTIONAL Google Gemini free-tier integration for NEXUS-100.
# Copy these values to your SECRET deployment configuration (not the repository).
# Create a free API key at https://aistudio.google.com/apikey
# The billing-free tier is quota limited and may use data to improve Google products.
# Never place your real key in a public frontend, GitHub Actions log or this file.
NEXUS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
NEXUS_LLM_API_KEY=YOUR_PRIVATE_GEMINI_API_KEY
NEXUS_MODEL_FAST=gemini-2.5-flash-lite
NEXUS_MODEL_BALANCED=gemini-2.5-flash
NEXUS_MODEL_STRONG=gemini-2.5-flash
NEXUS_MODEL_PREMIUM=gemini-2.5-flash
NEXUS_MODEL_DISCOVERY_ENABLED=false
NEXUS_LLM_REASONING_PARAMETER=
# Keep live inference OFF until authenticated deployment, quotas and key tested.
NEXUS_BACKEND_MODEL_EXECUTION_ENABLED=false
# Production execution requires NEXUS_API_TOKEN and a secret manager.
